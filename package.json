{
  "name": "delete-package-versions",
  "version": "0.0.0",
  "private": true,
  "description": "Delete GitHub package versions with retention and container reference protection",
  "main": "lib/main.js",
  "scripts": {
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts --fix",
    "lint-check": "eslint src/**/*.ts",
    "test": "jest",
    "build": "npm run format-check && npm run lint-check && npm run test && tsc",
    "pack": "rm -rf ./lib ./dist && npm run build && ncc build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnitVectorY-Labs/delete-package-versions.git"
  },
  "keywords": [
    "actions",
    "github-packages",
    "retention"
  ],
  "author": "UnitVectorY-Labs",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^8.0.1",
    "@octokit/rest": "^20.1.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^9.39.5",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.17.1",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "js-yaml": "^4.3.2",
    "msw": "^3.0.6",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "5.2.2"
  }
}
